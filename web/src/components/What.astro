---
import { url, BASE } from "../lib/paths";
// Datos de la página "Info. importante" del catálogo y del sello "Sin conservantes" de las fichas.
import { ALL_PRODUCTS, SEALED_COUNT } from "../data/products";
const facts = [
  { k: "Sin conservantes", v: `${SEALED_COUNT} de los ${ALL_PRODUCTS.length} productos del catálogo llevan el sello.` },
  { k: "Congelados x 12", v: "Laminados, chipas y cookies salen congelados, de a 12 unidades. ¿Cocidos? Consultanos." },
  { k: "48 hs antes", v: "Los pedidos de panadería y pastelería se hacen con 48 hs de anticipación." },
  { k: "Contra entrega", v: "Los pedidos se abonan contra entrega." },
  { k: "Fotos reales", v: "Todas las imágenes del catálogo son fotografías reales." },
];
---
<section id="que-hacemos" class="what" data-header="black" data-section="what">
  <div class="what__grid">
    <figure class="what__media">
      <img src={url("/assets/fotos/envoltorios.webp")} srcset={`${BASE}/assets/fotos/envoltorios-sm.webp 800w, ${BASE}/assets/fotos/envoltorios.webp 1080w`} sizes="(min-width: 900px) 45vw, 100vw" alt="Panes envueltos en el papel manteca de Cruda Haus, apilados" width="1080" height="1350" loading="lazy" decoding="async" />
    </figure>
    <div class="what__body">
      <div class="what__title">
        <p class="eyebrow">[Qué hacemos]</p>
        <h2>Fábrica y proveeduría mayorista de panadería y pastelería artesanal.</h2>
        <p class="what__lead">El pan y la pastelería de tu barra: de la masa madre al laminado.</p>
      </div>
      <div class="sheet sheet--info">
        <div class="sheet__row sheet__row--top">
          <span>[Info. importante]</span>
          <span class="sheet__center">Urban bakery</span>
          <span class="sheet__right">Actualización 2026</span>
        </div>
        <ul class="info-rows">
          {facts.map((f) => (
            <li class="info-row"><span class="info-row__k">{f.k}</span><span class="info-row__v">{f.v}</span></li>
          ))}
        </ul>
        <div class="sheet__row sheet__row--bottom">
          <span>Batch: 00 · Fecha: / 2026</span>
          <span></span>
          <span class="sheet__right">www.crudahaus.com.ar</span>
        </div>
      </div>
    </div>
  </div>
</section>
